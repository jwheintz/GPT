# --- Relay server ---
RELAY_PORT=8787
# If you deploy behind a reverse proxy, set this to your public base url (optional)
RELAY_BASE_URL=https://your-relay.example.com
# Comma-separated origins allowed by CORS (optional; leave empty to allow all)
CORS_ORIGINS=https://your-squarespace-site.com

ROOM_ID=classroom
STUDENT_TOKEN=change-me-student-token
AGENT_TOKEN=change-me-agent-token
ADMIN_TOKEN=change-me-admin-token
MAX_COMMANDS_PER_MINUTE=60
ALLOWLIST_PATH=relay/allowlist.json

# --- Studio agent ---
# Agent connects outbound to relay
RELAY_WS_URL=wss://your-relay.example.com/ws/agent

# OBS WebSocket (OBS 28+ includes this)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=your-obs-websocket-password

# Local panic control (you can call this from your own machine)
LOCAL_CONTROL_PORT=39200
LOCAL_CONTROL_TOKEN=change-me-local-control-token
PANIC_LOCKED=false
